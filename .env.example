# Copy to .env (gitignored) and edit. Used by docker-compose.yml, and — placed at
# backend/.env — by a plain `node backend/src/index.js` run as well.

# --- Server -------------------------------------------------------------
# Host port the app is published on (docker compose only).
PORT=3000

# Real deployment: don't create demo data. The default admin (ADMIN001 / admin123)
# is still created — sign in, CHANGE ITS PASSWORD, then add faculty/students in the Admin Panel.
# Leave unset for a demo with sample students/faculty.
# SKIP_SEED=true

# Behind HTTPS (recommended on the internet): only send the session cookie over TLS,
# and trust the reverse proxy's X-Forwarded-* headers.
# COOKIE_SECURE=true
# TRUST_PROXY=true

# --- Supabase file storage (optional) ------------------------------------
# Set ALL THREE to store submitted files in a private Supabase Storage bucket
# instead of local disk. Leave them unset to keep using backend/data/uploads/.
# The key is the project's SECRET key (Project Settings > API Keys: sb_secret_...,
# or the legacy service_role key). It stays on the server — never in the frontend.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=cdad-uploads
